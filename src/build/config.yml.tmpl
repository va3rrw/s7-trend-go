version: '3'

info:
  companyName: "Ken Wang"
  productName: "S7 Trend Go"
  productIdentifier: "ca.cetus.s7-trend-go"
  description: "S7 PLC Trend App built with Go and Wails"
  copyright: "Copyright (c) 2026 Ken Wang"
  comments: "S7 PLC Trend App built with Go and Wails"
  version: "@VERSION@"

dev_mode:
  root_path: .
  log_level: warn
  debounce: 1000
  ignore:
    dir:
      - .git
      - node_modules
      - frontend
      - bin
      - build/bin
    file:
      - .DS_Store
      - .gitignore
      - .gitkeep
      - "*_test.go"
    watched_extension:
      - "*.go"
    git_ignore: true
  executes:
    - cmd: wails3 build DEV=true
      type: blocking
    - cmd: wails3 task common:dev:frontend
      type: background
    - cmd: wails3 task run
      type: primary
      exit_policy: shutdown
